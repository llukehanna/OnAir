{
  "name": "onair",
  "version": "0.1.0",
  "description": "Live-stream player that stays on air: ranks HLS sources and fails over without a black frame",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "npm run build && electron-builder",
    "postinstall": "electron-builder install-app-deps",
    "setup:browser": "playwright install chromium",
    "test": "ELECTRON_RUN_AS_NODE=1 electron ./node_modules/jest/bin/jest.js",
    "test:browser": "ELECTRON_RUN_AS_NODE=1 electron ./node_modules/jest/bin/jest.js --testPathIgnorePatterns=/node_modules/ --testPathPatterns=tests/browser",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint src"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "better-sqlite3": "^11.8.1",
    "hls.js": "^1.5.20",
    "lucide-react": "^1.0.1",
    "playwright": "^1.50.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@electron/rebuild": "^4.0.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.13.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.3.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "eslint": "^9.21.0",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.8.2",
    "vite": "^6.2.1"
  }
}
